---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Opportunity from "../components/Opportunity.astro";
import WhatIsGrants from "../components/WhatIsGrants.astro";
import GrantVoucher from "../components/GrantVoucher.astro";
import Benefits from "../components/Benefits.astro";
import ExpertHelp from "../components/ExpertHelp.astro";
import Compliance from "../components/Compliance.astro";
import Problem from "../components/Problem.astro";
import Proof from "../components/Proof.astro";
import Marquee from "../components/Marquee.astro";
import HandleEverything from "../components/HandleEverything.astro";
import WhyUs from "../components/WhyUs.astro";
import HowWeWork from "../components/HowWeWork.astro";
import Pricing from "../components/Pricing.astro";
import LimitedSpots from "../components/LimitedSpots.astro";
import Quiz from "../components/Quiz.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import MobileNav from "../components/MobileNav.astro";
---

<Layout preloadHero>
  <span id="top" aria-hidden="true"></span>
  <Header />
  <main id="main-content">
    <Hero />
    <Opportunity />
    <WhatIsGrants />
    <GrantVoucher />
    <Benefits />
    <ExpertHelp />
    <Compliance />
    <Problem />
    <Proof />
    <Marquee />
    <HandleEverything />
    <WhyUs />
    <HowWeWork />
    <Pricing />
    <LimitedSpots />
    <Quiz />
    <FAQ />
  </main>
  <Footer />
  <MobileNav />
</Layout>
