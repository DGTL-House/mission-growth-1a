---
import { QUALIFY_HREF, QUALIFY_LABEL } from "../consts";

// "Ad invoice vs grant voucher" — the same $10K budget, two price tags.
const tickets = [
  {
    kicker: "Ad invoice",
    title: "Regular business",
    rows: [
      ["Monthly ad budget", "$10,000"],
      ["Who pays?", "You"],
    ],
    totalLabel: "Total due",
    total: "$10,000",
    note: "Paid out of pocket",
    voucher: false,
  },
  {
    kicker: "Grant voucher",
    title: "Eligible nonprofit",
    rows: [
      ["Monthly ad budget", "Up to $10K"],
      ["Who pays?", "Google"],
    ],
    totalLabel: "Ad click costs",
    total: "$0",
    note: "Covered by Google Ad Grants",
    voucher: true,
  },
];
---

<section class="section" aria-labelledby="gives-title">
  <div class="container-page">
    <div class="text-center">
      <p class="eyebrow reveal">What Google actually gives you</p>
      <h2 id="gives-title" class="h2 reveal mx-auto mt-5 max-w-[900px]">
        Get up to $10,000/month in Google Search ads at no cost to your
        nonprofit
      </h2>
      <p class="lead reveal mx-auto mt-4 max-w-[660px] xl:mt-5">
        Google Ad Grants is an official Google program, running since 2003, that
        gives registered 501(c)(3) nonprofits up to $10,000/month in free Search
        ads.
      </p>
      <a
        href={QUALIFY_HREF}
        class="btn btn-primary btn-lg reveal mt-6 w-full sm:w-auto xl:mt-8 xl:min-w-[332px]"
        >{QUALIFY_LABEL}</a
      >
    </div>

    <div class="reveal-stagger mt-8 grid gap-5 lg:grid-cols-2 xl:mt-8 xl:gap-8">
      {
        tickets.map((t) => (
          <article
            class:list={[
              "relative rounded-[24px] border px-6 pb-7 pt-7 xl:px-[45px] xl:pb-10 xl:pt-[45px]",
              t.voucher
                ? "border-voucher-line bg-voucher"
                : "border-[#e7e6e1] bg-white",
            ]}
          >
            <p class="font-mono text-[12px] font-medium uppercase tracking-[0.08em] text-body xl:text-[13px]">
              {t.kicker}
            </p>
            <h3 class="mt-3 text-[20px] font-medium text-ink xl:text-[26px]">
              {t.title}
            </h3>

            <dl
              class:list={[
                "mt-5 space-y-4 border-y border-t-dashed pb-6 pt-6 text-[16px] xl:mt-6 xl:text-[18px]",
                t.voucher
                  ? "border-b-[1.5px] border-t-[#b5cf65] border-b-ink"
                  : "border-b-[1.5px] border-t-[#d9d8d3] border-b-[#bdbcb5]",
              ]}
            >
              {t.rows.map(([k, v]) => (
                <div class="flex items-baseline gap-3">
                  <dt class="shrink-0 text-ink">{k}</dt>
                  <span
                    class:list={[
                      "flex-1 border-b-2 border-dotted",
                      t.voucher ? "border-[#a9c35a]" : "border-[#d4d3ce]",
                    ]}
                    aria-hidden="true"
                  />
                  <dd class="shrink-0 font-semibold text-ink">{v}</dd>
                </div>
              ))}
            </dl>

            {/* Ticket notches on the tear line */}
            <span
              class:list={[
                "absolute -left-[15px] top-[var(--notch)] size-[30px] rounded-full border bg-white",
                t.voucher ? "border-voucher-line" : "border-[#e7e6e1]",
              ]}
              aria-hidden="true"
            />
            <span
              class:list={[
                "absolute -right-[15px] top-[var(--notch)] size-[30px] rounded-full border bg-white",
                t.voucher ? "border-voucher-line" : "border-[#e7e6e1]",
              ]}
              aria-hidden="true"
            />

            <p class="mt-6 font-mono text-[12px] font-medium uppercase tracking-[0.08em] text-body xl:text-[13px]">
              {t.totalLabel}
            </p>
            <div class="relative flex items-end justify-between">
              <p
                class:list={[
                  "font-bold leading-none tracking-[-0.03em] text-ink",
                  t.voucher
                    ? "mt-3 text-[72px] xl:text-[120px]"
                    : "mt-10 text-[44px] xl:mt-[62px] xl:text-[72px]",
                ]}
              >
                {t.total}
              </p>
              {t.voucher && (
                <span class="mb-6 rotate-[6deg] rounded-[8px] border-2 border-[#4c5d35] px-3 py-2 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-[#4c5d35] xl:mb-8 xl:mr-[100px] xl:px-4 xl:py-2.5 xl:text-[14px]">
                  Covered by Google
                </span>
              )}
            </div>
            <p class="mt-3 text-[14px] text-body xl:mt-5 xl:text-[16px]">{t.note}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  article {
    /* Notch sits on the solid tear line under the rows. */
    --notch: 217px;
  }
  @media (min-width: 1280px) {
    article {
      --notch: 231px;
    }
  }
  .border-t-dashed {
    border-top-style: dashed;
  }
</style>
