---
import { QUALIFY_HREF, QUALIFY_LABEL } from "../consts";
import Icon from "./Icon.astro";

const steps = [
  {
    title: "Tell us about your nonprofit",
    text: "On a free 30-minute call we will discuss your mission, website, grant status and goals.",
  },
  {
    title: "Get a practical recommendation",
    text: "We will explain potential eligibility steps and a suitable approach, whether you are new to the grant or already using it.",
  },
  {
    title: "See your potential results",
    tag: "in-house tool",
    text: "Our in-house tool forecasts the website traffic your nonprofit could attract with Google Ad Grants.",
  },
  {
    title: "Let us handle the agreed work",
    text: "If you choose to partner with us, we can support setup, management, optimization and reporting.",
  },
];
---

<section id="how-we-work" class="section" aria-labelledby="hww-title">
  <div class="container-page grid gap-8 lg:grid-cols-[1fr_637px] lg:gap-10">
    <div>
      <h2
        id="hww-title"
        class="reveal text-[28px] font-medium leading-tight tracking-[-0.01em] text-ink xl:text-[40px]"
      >
        How we work
      </h2>
      <p
        class="reveal mt-3 max-w-[420px] text-[17px] leading-normal text-body xl:mt-4 xl:text-[18px]"
      >
        We'll review your goals, explore growth opportunities, and recommend the
        next steps for your nonprofit.
      </p>
      <a
        href={QUALIFY_HREF}
        class="btn btn-primary btn-lg reveal mt-6 hidden lg:inline-flex xl:mt-7 xl:px-6"
      >
        {QUALIFY_LABEL}
        <Icon name="arrow-right" size={18} />
      </a>
    </div>

    <div>
      <ol class="reveal-stagger">
        {
          steps.map((s, i) => (
            <li class="grid grid-cols-[36px_1fr] gap-x-6">
              <div class="flex flex-col items-center">
                <span class="grid size-9 place-items-center rounded-full bg-lime text-[17px] font-medium text-olive xl:text-[20px]">
                  {i + 1}
                </span>
                {i < steps.length - 1 && (
                  <span class="my-3 w-0.5 flex-1 bg-olive" aria-hidden="true" />
                )}
              </div>
              <div class:list={[i < steps.length - 1 && "pb-6 xl:pb-[26px]"]}>
                <h3 class="flex flex-wrap items-center gap-x-3.5 gap-y-1 text-[22px] font-medium leading-tight text-ink xl:-mt-0.5 xl:text-[32px]">
                  {s.title}
                  {s.tag && (
                    <span class="rounded-[4px] border border-lime bg-[#e1ffaf] px-2 py-0.5 text-[12px] font-medium text-olive">
                      {s.tag}
                    </span>
                  )}
                </h3>
                <p class="mt-3 text-[16px] leading-normal text-ink/80 xl:mt-4">
                  {s.text}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
      <a
        href={QUALIFY_HREF}
        class="btn btn-primary btn-lg mt-8 w-full lg:hidden"
      >
        {QUALIFY_LABEL}
      </a>
    </div>
  </div>
</section>
