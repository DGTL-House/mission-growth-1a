---
import { QUALIFY_HREF, QUALIFY_LABEL } from "../consts";
import Icon from "./Icon.astro";
---

<section class="section" aria-labelledby="limited-title">
  <div class="container-page">
    <div
      class="dark-panel reveal flex flex-col gap-5 rounded-[24px] p-6 md:flex-row md:items-center md:gap-6 xl:min-h-[215px] xl:rounded-[48px] xl:py-10 xl:pl-10 xl:pr-[30px]"
    >
      <img
        src="/img/limited-spots.webp"
        alt="Volunteers in blue T-shirts packing donation boxes"
        width="600"
        height="402"
        loading="lazy"
        decoding="async"
        class="aspect-[3/2] w-full rounded-[16px] object-cover md:w-[200px] md:shrink-0 xl:rounded-[24px]"
      />
      <div class="md:flex-1">
        <h2 id="limited-title" class="text-[20px] font-medium xl:text-[24px]">
          Limited spots available
        </h2>
        <p
          class="mt-3 max-w-[520px] text-[17px] font-light leading-normal text-white/85 xl:mt-4 xl:text-[18px]"
        >
          We currently have limited spots open for new nonprofits. Every month
          without the grant is $10,000 in free advertising you don't get back.
        </p>
      </div>
      <a
        href={QUALIFY_HREF}
        class="btn btn-primary btn-lg w-full shrink-0 md:w-auto xl:px-6"
      >
        {QUALIFY_LABEL}
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </div>
</section>
