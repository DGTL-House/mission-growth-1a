---
import { NAV } from "../consts";
import Icon from "./Icon.astro";

// Bottom section bar from the Figma mobile frame: a solid cream bar pinned to
// the viewport bottom once the hero is scrolled past, with horizontally scrolling nav
// pills and a separate back-to-top button. Mobile and tablet only.
const pills = [
  ...NAV.map((n) => ({ label: n.short, href: n.href })),
  { label: "Contact Us", href: "#contact" },
];
---

<nav
  class="fixed inset-x-0 bottom-0 z-30 translate-y-full rounded-t-[24px] bg-cream pb-[max(16px,env(safe-area-inset-bottom))] pt-3 transition-transform duration-300 data-[shown]:translate-y-0 lg:hidden"
  aria-label="Sections"
  inert
  data-mobile-nav
>
  <div class="flex items-center gap-2 pl-5 pr-5">
    <ul
      class="flex min-w-0 flex-1 gap-1.5 overflow-x-auto overflow-y-hidden overscroll-x-contain [touch-action:pan-x] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      {
        pills.map((p) => (
          <li class="shrink-0">
            <a
              href={p.href}
              class="btn btn-primary h-9 px-3.5 text-[13px]"
            >
              {p.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="#top"
      class="btn btn-primary size-9 shrink-0 p-0"
      aria-label="Back to top"
    >
      <Icon name="arrow-up" size={16} />
    </a>
  </div>
</nav>

<script>
  // Hidden over the hero; slides in once the next block fills most of the
  // screen (the hero's bottom edge rises above mid-viewport — on phones the
  // hero is shorter than the screen, so "partly visible" would be too early).
  // `inert` keeps the hidden bar out of the tab order.
  const nav = document.querySelector<HTMLElement>("[data-mobile-nav]")!;
  const hero = document.querySelector<HTMLElement>("main > section");
  let frame = 0;
  function update() {
    frame = 0;
    const shown = !hero || hero.getBoundingClientRect().bottom < innerHeight / 2;
    nav.toggleAttribute("data-shown", shown);
    nav.inert = !shown;
  }
  const schedule = () => {
    if (!frame) frame = requestAnimationFrame(update);
  };
  addEventListener("scroll", schedule, { passive: true });
  addEventListener("resize", schedule);
  update();
</script>
