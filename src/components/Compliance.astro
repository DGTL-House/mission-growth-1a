---
import { QUALIFY_HREF, QUALIFY_LABEL } from "../consts";
import Icon from "./Icon.astro";

const rules = [
  {
    title: "A click-through rate of at least 5%",
    text: "Higher than most commercial advertisers manage. Sustained performance below it puts the account at risk.",
  },
  {
    title: "The account structure the program requires",
    text: "Campaigns, ad groups and ads have to be built the way the program specifies, not the way a standard ad account is built.",
  },
  {
    title: "Keyword work that does not stop",
    text: "Single-word and overly generic keywords are not permitted, and negative keywords need maintaining as search behaviour changes.",
  },
  {
    title: "Quality Score kept up",
    text: "Low-scoring keywords stop serving. This is a common reason a live account spends a fraction of the available budget.",
  },
  {
    title: "A compliant website and working conversion tracking",
    text: "Google checks both. Without tracking there is also no evidence of what the grant is delivering for you.",
  },
];
---

<section class="section" aria-labelledby="compliance-title">
  <div class="container-page">
    <div
      class="card-cream reveal grid gap-8 rounded-[24px] px-4 py-8 lg:grid-cols-[1fr_minmax(0,572px)] lg:gap-10 xl:rounded-[48px] xl:pb-[52px] xl:pl-[82px] xl:pr-[82px] xl:pt-[56px]"
    >
      <div class="px-1 xl:pt-0.5">
        <p class="eyebrow">Grant compliance</p>
        <h2
          id="compliance-title"
          class="mt-5 max-w-[450px] text-[28px] font-medium leading-[1.07] tracking-[-0.01em] text-ink xl:mt-6 xl:text-[44px] xl:leading-[1.09]"
        >
          What does Google require to keep your Ad Grant?
        </h2>
        <p
          class="mt-4 max-w-[490px] text-[17px] font-light leading-normal text-body xl:mt-7 xl:text-[20px]"
        >
          Google attaches performance and structure requirements to the grant
          that a paying advertiser never has to meet. Meeting them is not a
          one-off setup task.
        </p>
        <a
          href={QUALIFY_HREF}
          class="btn btn-primary btn-lg mt-6 w-full sm:w-auto xl:mt-7 xl:px-6"
        >
          {QUALIFY_LABEL}
          <Icon name="arrow-right" size={18} />
        </a>
      </div>

      <ul class="reveal-stagger space-y-3">
        {
          rules.map((r) => (
            <li class="flex gap-5 rounded-[24px] bg-white p-5 xl:px-7 xl:py-6">
              <span class="grid size-10 shrink-0 place-items-center rounded-[12px] bg-blush">
                <Icon name="x-badge" size={20} />
              </span>
              <div>
                <h3 class="text-[17px] font-semibold leading-tight text-ink xl:text-[20px] xl:leading-[1.3]">
                  {r.title}
                </h3>
                <p class="mt-1.5 text-[14px] leading-normal text-ink/80 xl:text-[15px]">
                  {r.text}
                </p>
              </div>
            </li>
          ))
        }
        <li
          class="rounded-[24px] border border-covered-line bg-covered p-5 xl:px-6 xl:py-6"
        >
          <span
            class="inline-flex h-9 items-center gap-2 rounded-full bg-olive px-3.5 text-[15px] font-medium text-[#e9f5d3]"
          >
            <Icon name="check-circle-outline" size={18} />
            We've got it covered
          </span>
          <h3
            class="mt-4 text-[17px] font-semibold leading-tight text-ink xl:text-[20px]"
          >
            We handle the complexity
          </h3>
          <p class="mt-1.5 text-[14px] leading-normal text-ink/80 xl:text-[15px]">
            We manage Google Ad Grants for nonprofits across all sectors,
            handling everything from compliance to optimization so you can focus
            on your mission.
          </p>
        </li>
      </ul>
    </div>
  </div>
</section>
