---
import { QUALIFY_HREF, QUALIFY_LABEL } from "../consts";
import Icon from "./Icon.astro";

// Monthly prices are the Figma main frame; yearly ones are its "Pay Yearly"
// state. Feature lists stay the same in both — billing only changes the price.
const plans = [
  {
    name: "Ad Grant Management",
    desc: "Google Ad Grant setup and ongoing management",
    monthly: "$250",
    yearly: { price: "$200", billed: "$2,400", save: "$600", pct: "20%" },
    includedLead: null,
    features: [
      ["Google Ad Grant application & setup"],
      ["Campaign creation & launch"],
      ["Keyword research"],
      ["Ongoing Ad Grant management"],
      ["All dev support", "50% off"],
    ],
    featured: false,
  },
  {
    name: "Growth Partner",
    desc: "Ad Grant + SEO, analytics & dedicated project manager",
    monthly: "$500",
    yearly: { price: "$350", billed: "$4,200", save: "$1,800", pct: "30%" },
    includedLead: "Everything in Ad Grant Management",
    features: [
      ["Website SEO optimization"],
      ["Full web analytics setup"],
      ["Personal project manager"],
      ["Light website edits included"],
      ["Up to 4 hrs/mo SEO work"],
      ["All dev support", "70% off"],
    ],
    featured: true,
  },
  {
    name: "Impact Partner",
    desc: "A complete digital marketing team for your nonprofit",
    monthly: "$1,000",
    yearly: { price: "$650", billed: "$7,800", save: "$4,200", pct: "35%" },
    includedLead: "Everything in Growth Partner",
    features: [
      ["Local SEO & Google Business Profile"],
      ["Website edits & new page creation"],
      ["Blog research, writing & publishing"],
      ["Social media content & posting"],
      ["Up to 4 hrs/mo SEO work"],
      ["Up to 5 hrs/mo dev support"],
    ],
    featured: false,
  },
];

// Compare-all-features table (scope from the nonprofit landing).
type Cell = boolean | string;
const groups: { title: string; rows: [string, Cell, Cell, Cell][] }[] = [
  {
    title: "Google Ad Grant",
    rows: [
      ["Google for Nonprofits registration", true, true, true],
      ["Ad Grant application & approval", true, true, true],
      ["Conversion tracking setup in Google Ads", true, true, true],
      ["Performance Max campaign setup", true, true, true],
      ["Ongoing high-intent keyword research", true, true, true],
      ["Ongoing campaign creation, testing, and launch", true, true, true],
      ["Ongoing optimization to reach the full $10K/month", true, true, true],
      ["Grant compliance monitoring", true, true, true],
      ["Heatmaps & visitor recordings setup", false, true, true],
      ["Monthly performance reporting", true, true, true],
    ],
  },
  {
    title: "AEO, SEO & Organic Growth",
    rows: [
      ["On-page SEO", false, "4 hrs/mo", "4 hrs/mo"],
      ["Technical SEO", false, true, true],
      ["Full web analytics setup (GA4, GTM, GSC, Looker reports)", false, true, true],
      ["AEO — Answer Engine Optimization", false, false, true],
      ["Local SEO & Google Business Profile", false, false, true],
    ],
  },
  {
    title: "Website",
    rows: [
      ["CRO — Conversion rate optimization", false, false, true],
      ["Website edits & new page creation", false, "Light edits", true],
      ["Dev support", "50% off", "70% off", "5 hrs/mo"],
    ],
  },
  {
    title: "Content & Social",
    rows: [
      ["Blog research, writing & publishing", false, false, true],
      ["Social media content & posting", false, false, true],
    ],
  },
  {
    title: "Support",
    rows: [["Personal project manager", false, true, true]],
  },
];
---

<section
  id="pricing"
  class="section"
  aria-labelledby="pricing-title"
  data-billing="monthly"
  data-pricing
>
  <div class="container-page">
    <div class="text-center">
      <p class="eyebrow reveal">What it costs</p>
      <h2 id="pricing-title" class="h2 reveal mt-5">Services &amp; what’s included</h2>
      <p class="lead lead-lg reveal mx-auto mt-4 max-w-[680px] xl:mt-5">
        Our non-profit partnership program covers <strong class="font-semibold"
          >50% of the full package</strong
        > cost — no extra fees or hidden costs
      </p>

      <div
        class="reveal mx-auto mt-6 flex h-14 w-full max-w-[344px] items-center gap-1 rounded-[12px] border border-[#e4e3de] bg-white p-1 xl:mt-9"
        role="radiogroup"
        aria-label="Billing period"
      >
        <button
          type="button"
          role="radio"
          aria-checked="true"
          class="h-full flex-1 rounded-[8px] text-[16px] font-medium text-ink transition-colors aria-checked:bg-pill"
          data-billing-option="monthly"
        >
          Pay Monthly
        </button>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          class="flex h-full flex-1 items-center justify-center gap-2.5 rounded-[8px] text-[16px] font-medium text-ink transition-colors aria-checked:bg-pill"
          data-billing-option="yearly"
        >
          Pay Yearly
          <span
            class="rounded-[6px] bg-olive px-2 py-1 text-[11px] leading-[1.1] text-lime"
            >Up to<br />35% off</span
          >
        </button>
      </div>
    </div>

    <ul
      class="reveal-stagger mt-8 grid items-start gap-4 lg:grid-cols-[443fr_393fr_393fr] xl:mt-12 xl:gap-[25px]"
    >
      {
        plans.map((p) => (
          <li
            class:list={[
              "overflow-hidden rounded-[24px] border xl:rounded-[40px]",
              p.featured
                ? "border-line bg-cream"
                : "border-line bg-white",
            ]}
          >
            <div class="px-6 pb-6 pt-7 xl:px-[33px] xl:pb-8 xl:pt-[33px]">
              <span class="price-yearly mb-3 inline-block rounded-full bg-olive px-2.5 py-1 text-[14px] font-medium text-lime">
                Save {p.yearly.pct}
              </span>
              <h3 class="text-[20px] font-medium leading-tight text-ink xl:text-[24px]">
                {p.name}
              </h3>
              <p class="mt-2 max-w-[300px] text-[15px] leading-normal text-ink xl:text-[16px]">
                {p.desc}
              </p>

              <div class="price-monthly mt-6 flex items-end gap-2.5 xl:mt-[26px]">
                <span class="text-[40px] font-semibold leading-none tracking-[-0.03em] text-ink xl:text-[60px]">
                  {p.monthly}
                </span>
                <span class="pb-1 text-[16px] leading-tight text-body">
                  per
                  <br />
                  month
                </span>
              </div>

              <div class="price-yearly mt-5">
                <p class="flex flex-wrap items-center gap-2">
                  <s class="text-[20px] text-muted xl:text-[22px]">{p.monthly}</s>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-[#e9f7cf] px-3 py-1 text-[14px] font-medium text-olive xl:text-[15px]">
                    <Icon name="check-circle-outline" size={16} />
                    You save {p.yearly.save} per year
                  </span>
                </p>
                <p class="mt-2 flex items-end gap-2.5">
                  <span class="text-[40px] font-semibold leading-none tracking-[-0.03em] text-ink xl:text-[60px]">
                    {p.yearly.price}
                  </span>
                  <span class="pb-1 text-[16px] leading-tight text-body">
                    per
                    <br />
                    month
                  </span>
                </p>
                <p class="mt-3 text-[15px] text-body xl:text-[16px]">
                  {p.yearly.billed} billed annually
                </p>
              </div>

              <a
                href={QUALIFY_HREF}
                class="btn btn-primary mt-6 h-14 w-full text-[17px] xl:mt-8 xl:h-[72px] xl:max-w-[328px] xl:text-[18px]"
              >
                {QUALIFY_LABEL}
              </a>
            </div>

            <div class="border-t border-[#dbdbd8] px-6 pb-7 pt-6 xl:px-[33px] xl:pb-[33px] xl:pt-[30px]">
              <p class="text-[17px] font-medium text-ink xl:text-[18px]">What’s included</p>
              {p.includedLead && (
                <p class="mt-1.5 text-[15px] text-body xl:text-[16px]">{p.includedLead}</p>
              )}
              <ul class="mt-5 space-y-4 xl:mt-[26px] xl:space-y-[28px]">
                {p.features.map(([label, tag]) => (
                  <li class="flex items-center gap-2 text-[15px] text-ink/85 xl:text-[16px]">
                    <Icon name="check-olive" size={20} class="shrink-0" />
                    {label}
                    {tag && (
                      <span class="rounded-[4px] border border-lime bg-[#e1ffaf] px-1.5 py-0.5 text-[12px] font-semibold uppercase text-olive">
                        {tag}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <p
    class="mt-8 flex items-center justify-center gap-3 bg-cream px-5 py-4 text-left text-[15px] text-ink xl:mt-8 xl:text-center xl:text-[16px]"
  >
    <span
      class="grid size-[30px] shrink-0 place-items-center rounded-[10px] border border-[#cde2a8] bg-lime-soft text-olive"
    >
      <Icon name="gift" size={16} />
    </span>
    <span>
      No website? We'll build one for your nonprofit at no extra cost — <strong
        class="font-semibold">included with every plan</strong
      >
    </span>
  </p>

  <div class="container-page">
    <details class="group mt-8 xl:mt-10" data-compare>
      <summary
        class="mx-auto flex w-max cursor-pointer list-none items-center gap-3 text-[17px] font-medium text-ink [&::-webkit-details-marker]:hidden xl:text-[20px]"
      >
        <span class="border-b-2 border-ink pb-0.5">Compare all features</span>
        <Icon
          name="chevron-up"
          size={18}
          class="rotate-180 transition-transform group-open:rotate-0"
        />
      </summary>

      <div class="mt-8 overflow-x-auto rounded-[24px] border border-line">
        <table class="w-full min-w-[640px] border-collapse text-left text-[14px] xl:text-[16px]">
          <thead>
            <tr class="bg-cream">
              <th class="w-[46%] px-5 py-4 font-medium text-body" scope="col">
                Feature
              </th>
              {
                plans.map((p) => (
                  <th class="px-3 py-4 text-center font-medium text-ink" scope="col">
                    {p.name}
                  </th>
                ))
              }
            </tr>
          </thead>
          {
            groups.map((g) => (
              <tbody>
                <tr>
                  <th
                    colspan="4"
                    scope="colgroup"
                    class="border-t border-line bg-white px-5 pb-2 pt-5 font-mono text-[12px] font-medium uppercase tracking-[0.06em] text-body"
                  >
                    {g.title}
                  </th>
                </tr>
                {g.rows.map(([label, ...cells]) => (
                  <tr class="border-t border-[#efeee9]">
                    <th scope="row" class="px-5 py-3 font-normal text-ink/85">
                      {label}
                    </th>
                    {cells.map((c) => (
                      <td class="px-3 py-3 text-center">
                        {c === true ? (
                          <Icon name="check-olive" size={20} class="mx-auto" />
                        ) : c === false ? (
                          <span class="text-muted" aria-label="Not included">—</span>
                        ) : (
                          <span class="font-medium text-olive">{c}</span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            ))
          }
        </table>
      </div>
    </details>
  </div>
</section>

<style>
  [data-billing="monthly"] .price-yearly,
  [data-billing="yearly"] .price-monthly {
    display: none;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-pricing]")!;
  const options = root.querySelectorAll<HTMLButtonElement>("[data-billing-option]");
  options.forEach((btn) =>
    btn.addEventListener("click", () => {
      root.dataset.billing = btn.dataset.billingOption;
      options.forEach((o) => o.setAttribute("aria-checked", String(o === btn)));
    }),
  );
</script>
